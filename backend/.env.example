# LLM - OpenRouter primary, Groq fallback
OPENROUTER_API_KEY=
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
# alt: anthropic/claude-3.5-haiku, openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# alt: llama-3.1-8b-instant (fastest)
LLM_PROVIDER=openrouter
LLM_FALLBACK=groq
LLM_TIMEOUT_S=8

# TTS - kokoro local is default (no key), elevenlabs/fish optional premium
TTS_PROVIDER=kokoro
TTS_PREMIUM=none
# kokoro
KOKORO_LANG=auto
# elevenlabs (multilingual v2, realistic)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
# fish speech
FISH_API_KEY=
FISH_VOICE_ID=

# Character voice overrides (kokoro voice ids)
VOICE_ELLEN=kokoro-af_sky
VOICE_JANE=kokoro-af_bella
VOICE_ZHU=kokoro-af_nicole
# japanese variants when lang=ja detected: jf_alpha, jf_gongitsune, jf_sakura

# Server
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WS_HEARTBEAT_S=20
LOG_LEVEL=info

# Remote (set for production)
# CORS_ORIGINS=https://your-viewer.example.com,http://localhost:5173
