{
  "name": "@waifu/desktop",
  "version": "0.3.9",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently --kill-others --names vite,electron \"npx vite --config vite.config.js\" \"wait-on http://127.0.0.1:5173 --timeout 30000 && electron .\"",
    "dev:vite": "npx vite --config vite.config.js",
    "build": "npm --prefix ../../waifu-viewer run build && electron-builder",
    "start": "electron .",
    "start:headless": "electron . --no-sandbox --disable-gpu",
    "electron:dev": "electron electron/main.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  }
}
